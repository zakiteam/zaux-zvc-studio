NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Assumed Plesk production path; confirm the subscription root on the server.
NUXT_MEDIA_STORAGE_DIR=/var/www/vhosts/zaki.it/zaux-studio-media
# Production URL. Also set this variable in Plesk Node.js environment settings.
NUXT_MEDIA_PUBLIC_BASE_URL=https://zaux-studio.zaki.it/media

# Read access (Contents: read) to the private zakiteam/zaux repository, used by
# scripts/zaux/install.mjs to download the release set in package.json#zaux.version.
ZAUX_GITHUB_TOKEN=GITHUB_TOKEN READ
# Optional overrides: another release tag, or a local Zaux checkout to copy.
# ZAUX_VERSION=v2.3.3
# ZAUX_SOURCE_DIR=../zaux
# Versions outside package.json#zaux.supported are refused unless this is set.
# ZAUX_ALLOW_UNSUPPORTED=1
